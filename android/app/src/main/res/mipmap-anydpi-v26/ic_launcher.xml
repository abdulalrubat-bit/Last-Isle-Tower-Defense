<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. The maskable PNG the web manifest already ships is drawn
     with its safe zone inside the circle, which is exactly what Android wants
     for the foreground layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/backgroundColor" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
